# Copie para .env e preencha. O .env fica fora do Git.
POSTGRES_PASSWORD=troque-esta-senha
DB_PASSWORD=troque-esta-senha

# Mínimo 32 caracteres aleatórios. Gere com: openssl rand -base64 48
ZONAGEO_JWT_SECRET=

# Administrador inicial (criado só se ainda não existir). Use senha forte.
ZONAGEO_ADMIN_USER=
ZONAGEO_ADMIN_PASSWORD=

# true = cria pontos de demonstração na primeira execução (apenas desenvolvimento)
ZONAGEO_SEED_DEMO=false

# Busca de lugares (Google Places API New). Opcional: sem ela, usa o OpenStreetMap.
GOOGLE_MAPS_API_KEY=sua-chave-do-google

# Resumo opcional das recomendaÃ§Ãµes no app (Google Gemini API)
GEMINI_API_KEY=sua-chave-gemini

# Recuperação de acesso: true redefine a senha do admin para ZONAGEO_ADMIN_PASSWORD no próximo start. Desligue depois.
ZONAGEO_ADMIN_RESET_PASSWORD=false
